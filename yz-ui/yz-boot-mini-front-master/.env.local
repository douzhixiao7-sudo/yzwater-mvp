# 本地开发环境：本地启动所有项目（前端、后端、APP）时使用，不依赖外部环境
NODE_ENV=development

VITE_DEV=true

# 本地前端开发端口
VITE_PORT=5173

# 请求路径：本地后端（勿再覆盖为远程，否则本地改动不会生效）
VITE_BASE_URL='http://localhost:48082'

# 如需连远程联调，再临时取消下一行注释，并注释掉上面的 localhost
# VITE_BASE_URL='http://221.178.149.154:9010'

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持 S3 服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=false

# 打包路径
VITE_BASE_PATH=/

# 商城H5会员端域名
VITE_MALL_H5_DOMAIN='http://localhost:3000'

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=false

# GoView域名
VITE_GOVIEW_URL='http://127.0.0.1:3000'

# 本地退出登录：回到本机登录页（不跳作战室导航）
VITE_LOGOUT_NAVIGATION_URL='http://localhost:5173/login'
