# 生产环境：只在打包时使用
NODE_ENV=production

VITE_DEV=false

# 请求路径
#仪征现场环境VITE_BASE_URL='http://192.168.6.101:48082'
#VITE_BASE_URL='https://yzriver.sy-digit.com'
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 打包路径
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist-prod

# 商城H5会员端域名
VITE_MALL_H5_DOMAIN='http://mall.yz.iocoder.cn'

# GoView域名
VITE_GOVIEW_URL='http://127.0.0.1:3000'

# 退出系统：勿固定 VITE_LOGOUT_NAVIGATION_URL（否则外网也会跳内网）。由内网/外网 hostname 自动选导航，详见 UserInfo.vue。
# VITE_LOGOUT_NAVIGATION_URL=http://...
