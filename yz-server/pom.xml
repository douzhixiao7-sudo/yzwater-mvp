<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.sydigit.yz</groupId>
        <artifactId>yz</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>yz-server</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
    </description>
    <url>https://github.com/YunaiV/ruoyi-vue-pro</url>

    <dependencies>
        <dependency>
            <groupId>com.sydigit.yz</groupId>
            <artifactId>yz-module-system</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.sydigit.yz</groupId>
            <artifactId>yz-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.sydigit.yz</groupId>
            <artifactId>yz-water</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.hikvision.ga</groupId>
            <artifactId>artemis-http-client</artifactId>
            <version>1.1.15.RELEASE</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../lib/artemis-http-client-1.1.15.RELEASE.jar</systemPath>
        </dependency>

        <!-- spring boot 配置所需依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 服务保障相关 -->
        <dependency>
            <groupId>com.sydigit.yz</groupId>
            <artifactId>yz-spring-boot-starter-protection</artifactId>
        </dependency>

    </dependencies>

    <build>
        <!-- 设置构建的 jar 包名 -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Spring Boot 打包插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <layout>ZIP</layout>
                    <mainClass>com.sydigit.yzwater.server.YzServerApplication</mainClass>
                    <includeSystemScope>false</includeSystemScope>
                    <excludeDevtools>true</excludeDevtools>
                    <addResources>false</addResources>
                    <includes>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-module-system</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-module-infra</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-water</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-common</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-module-report</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-biz-data-permission</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-biz-tenant</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-biz-ip</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-security</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-web</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-websocket</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-mybatis</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-redis</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-job</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-mq</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-excel</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-monitor</artifactId>
                        </include>
                        <include>
                            <groupId>com.sydigit.yz</groupId>
                            <artifactId>yz-spring-boot-starter-protection</artifactId>
                        </include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 复制依赖到 lib 目录 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <!-- 下列内部 jar 已打进 yz-server.jar（BOOT-INF/lib），避免重复复制到 target/lib -->
                            <excludeArtifactIds>yz-module-system,yz-module-infra,yz-water,yz-module-report,yz-common,yz-spring-boot-starter-biz-data-permission,yz-spring-boot-starter-biz-tenant,yz-spring-boot-starter-biz-ip,yz-spring-boot-starter-security,yz-spring-boot-starter-web,yz-spring-boot-starter-websocket,yz-spring-boot-starter-mybatis,yz-spring-boot-starter-redis,yz-spring-boot-starter-job,yz-spring-boot-starter-mq,yz-spring-boot-starter-excel,yz-spring-boot-starter-monitor,yz-spring-boot-starter-protection</excludeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-local-artemis-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.parent.basedir}/lib</directory>
                                    <includes>
                                        <include>artemis-http-client-1.1.15.RELEASE.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
