<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.sydigit.yz</groupId>
        <artifactId>yz</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>yz-module-report</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        report 模块，主要实现数据可视化报表等功能。
        1. 基于「积木报表」实现，打印设计、报表设计、图形设计、大屏设计等。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.sydigit.yz</groupId>
            <artifactId>yz-module-system</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 业务组件 -->
        <dependency>
            <groupId>com.sydigit.yz</groupId>
            <artifactId>yz-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.sydigit.yz</groupId>
            <artifactId>yz-spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sydigit.yz</groupId>
            <artifactId>yz-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.sydigit.yz</groupId>
            <artifactId>yz-spring-boot-starter-mybatis</artifactId>
        </dependency>

      <!--  &lt;!&ndash; Test 测试相关 &ndash;&gt;
        <dependency>
            <groupId>com.sydigit.yz</groupId>
            <artifactId>yz-spring-boot-starter-test</artifactId>
        </dependency>-->

        <!-- 积木报表-->
        <dependency>
            <groupId>org.jeecgframework.jimureport</groupId>
            <artifactId>jimureport-spring-boot3-starter-fastjson2</artifactId>
            <exclusions>
                <!-- 统一使用 fastexcel 依赖链中的 POI 5.x，避免和老版 schemas 冲突导致 Excel 导出 NoSuchFieldError -->
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>poi-ooxml-schemas</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>poi-scratchpad</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>ooxml-schemas</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.jeecgframework.jimureport</groupId>
            <artifactId>jimubi-spring-boot3-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>poi-ooxml-schemas</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>poi-scratchpad</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>ooxml-schemas</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.sydigit.yz</groupId>
            <artifactId>yz-spring-boot-starter-excel</artifactId>
        </dependency>

    </dependencies>
</project>
